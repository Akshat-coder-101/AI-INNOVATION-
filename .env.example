# ============================================================
# Sahayak AI Teacher — Environment Variables Template
# Copy this file to .env (backend / workspace root) and .env.local (frontend)
# Fill in your own API keys before running the application.
# ============================================================

# ---------- LLM Configuration ----------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ---------- Text-to-Speech (Multilingual Voice) ----------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- Speech-to-Text ----------
WHISPER_API_KEY=your_openai_or_whisper_key_here

# ---------- AI Avatar / Video Generation ----------
AVATAR_PROVIDER=did          # did | heygen
DID_API_KEY=your_d_id_api_key_here
HEYGEN_API_KEY=your_heygen_api_key_here
AVATAR_DEFAULT_ID=amy-j37u

# ---------- Database & Vector Store ----------
# Default SQLite fallback works out of the box:
DATABASE_URL=sqlite:///./sahayak.db

# Optional Supabase / Postgres & pgvector:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_STORAGE_BUCKET=lesson-media

# Optional Pinecone:
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ai-teacher-index

# ---------- Frontend / Application URLs ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=generate_a_random_secret_here

# ---------- Backend Server Settings ----------
BACKEND_PORT=8000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hinglish
MAX_UPLOAD_MB=25
LOG_LEVEL=info
