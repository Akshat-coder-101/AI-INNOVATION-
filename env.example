# ============================================================
# Sahayak AI Teacher — Environment Variables
# Copy this file to .env (backend) and .env.local (frontend as needed)
# NEVER commit the real .env file. Add .env to .gitignore.
# ============================================================

# ---------- LLM Configuration ----------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
LLM_PROVIDER_ORDER=gemini,groq,anthropic

# ---------- Embedding & Vector RAG ----------
EMBEDDING_PROVIDER=gemini           # gemini (text-embedding-004) | deterministic (SHA-256 fallback)

# ---------- Text-to-Speech (Multilingual Voice) ----------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- Speech-to-Text (Student Voice Input) ----------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# ---------- AI Avatar / Teaching Video Generation ----------
AVATAR_PROVIDER=free_avatar        # free_avatar (no key needed) | huggingface | colossyan | did | heygen
HUGGINGFACE_API_KEY=               # Optional: Free API token from https://huggingface.co/settings/tokens
COLOSSYAN_API_KEY=your_colossyan_api_key_here
DID_API_KEY=
HEYGEN_API_KEY=
CRAFTSTORY_API_KEY=
AVATAR_DEFAULT_ID=amy-j37u

# ---------- Database & Vector Store ----------
DATABASE_URL=sqlite:///./sahayak.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_STORAGE_BUCKET=lesson-media

# ---------- Vector DB alternative ----------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ai-teacher-index
PINECONE_HOST=https://your-index-host.pinecone.io

# ---------- Media & Static Storage ----------
MEDIA_DIR=generated_media

# ---------- App / Auth ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=generate_a_random_secret_here

# ---------- Backend service ----------
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Misc ----------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hinglish
MAX_UPLOAD_MB=25
LOG_LEVEL=info
