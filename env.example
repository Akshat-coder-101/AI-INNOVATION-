# ============================================================
# Sahayak AI Teacher — Environment Variables
# Copy this file to .env (backend) and .env.local (frontend as needed)
# NEVER commit the real .env file. Add .env to .gitignore.
# ============================================================

# ---------- LLM (reasoning / lesson planning / evaluation) ----------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional fallback/alt provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# ---------- Text-to-Speech (multilingual voice) ----------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=your_default_voice_id_here

# ---------- Speech-to-Text (optional voice input from student) ----------
WHISPER_API_KEY=your_openai_or_whisper_key_here

# ---------- AI Avatar / Teaching Video Generation ----------
AVATAR_PROVIDER=did          # did | heygen
DID_API_KEY=your_d_id_api_key_here
HEYGEN_API_KEY=your_heygen_api_key_here
AVATAR_DEFAULT_ID=your_default_avatar_id_here

# ---------- Database & Vector Store (Supabase Postgres + pgvector) ----------
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_STORAGE_BUCKET=lesson-media

# ---------- Vector DB alternative (if not using pgvector) ----------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ai-teacher-index

# ---------- App / Auth ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=generate_a_random_secret_here

# ---------- Backend service ----------
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Misc ----------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hinglish
MAX_UPLOAD_MB=25
LOG_LEVEL=info
